{
  "name": "lunaria-claim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action that manages translation claim issues driven by Lunaria status output",
  "license": "MIT",
  "main": "main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
